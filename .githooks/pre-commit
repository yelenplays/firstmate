#!/usr/bin/env bash
# Tracked repository pre-commit hook for the token cap. Install once per clone
# with `git config core.hooksPath .githooks` and it refuses agent-authored
# staged files over the cap; the logic and its rules live in the script below.
exec "$(cd "$(dirname "$0")/.." && pwd -P)/bin/fm-precommit-token-cap.sh" "$@"
